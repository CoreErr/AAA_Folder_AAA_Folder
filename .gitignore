(
echo # Python cache and virtual environments
echo __pycache__/
echo *.py[cod]
echo venv/
echo .venv/
echo env/
echo .env
echo .pytest_cache/
echo.
echo # Local cluster credentials only
echo *.kubeconfig
echo kubeconfig*
echo.
echo # OS & Editor files
echo .DS_Store
echo Thumbs.db
echo .vscode/
echo .idea/
) > .gitignore && git add .gitignore && git commit -m "Update .gitignore to keep executables and Helm assets" && git push